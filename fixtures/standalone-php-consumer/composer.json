{
    "name": "fixture/standalone-php-consumer",
    "description": "Pure PHP 8.4+ consumer fixture verifying axiomasoft/packman works with zero Illuminate or Laravel dependencies.",
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fixture\\StandalonePhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fixture\\StandalonePhp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
