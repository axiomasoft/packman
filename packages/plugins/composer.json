{
    "name": "axiomasoft/packman-plugins",
    "description": "Universal Packman intra-package plugin graph compiler, capabilities, typed slots, and immutable contribution registry.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "homepage": "https://github.com/axiomasoft/packman",
    "support": {
        "issues": "https://github.com/axiomasoft/packman/issues",
        "source": "https://github.com/axiomasoft/packman",
        "security": "https://github.com/axiomasoft/packman/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^0.1.1",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "conflict": {
        "axiomasoft/packman-schema": "<0.1.1"
    },
    "suggest": {
        "axiomasoft/packman-schema": "Optional schema ownership integration for plugins declaring owned schema nouns."
    },
    "autoload": {
        "psr-4": {
            "Packman\\Plugins\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packman\\Plugins\\Tests\\": "tests/"
        }
    },
    "extra": {
        "packman": {
            "error-prefix": "plugins"
        },
        "laravel": {
            "providers": [
                "Packman\\Plugins\\Laravel\\PluginsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
