{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "axiomasoft/packman-filament configuration",
    "type": "object",
    "properties": {
        "packman-filament": {
            "type": "object",
            "properties": {
                "abilities": {
                    "type": "array"
                },
                "enforce": {
                    "type": "boolean",
                    "default": false
                },
                "exclude": {
                    "type": "object",
                    "properties": {
                        "pages": {
                            "type": [
                                "array",
                                "object"
                            ]
                        },
                        "resources": {
                            "type": [
                                "array",
                                "object"
                            ]
                        },
                        "widgets": {
                            "type": [
                                "array",
                                "object"
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "guard_panel": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null
                },
                "navigation_group": {
                    "type": "string",
                    "default": "Packman"
                },
                "persistent_middleware": {
                    "type": [
                        "array",
                        "object"
                    ]
                },
                "refuse_unverifiable_downloads": {
                    "type": "boolean",
                    "default": true
                },
                "resources": {
                    "anyOf": [
                        {
                            "type": "array",
                            "maxItems": 0
                        },
                        {
                            "type": "object",
                            "additionalProperties": {
                                "type": "boolean"
                            }
                        }
                    ]
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
