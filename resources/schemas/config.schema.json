{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "axiomasoft/packman configuration",
    "type": "object",
    "properties": {
        "packman": {
            "type": "object",
            "properties": {
                "acknowledged_dangerous_modes": {
                    "type": [
                        "array",
                        "object"
                    ]
                },
                "errors": {
                    "type": "object",
                    "properties": {
                        "urn_prefix": {
                            "type": "string",
                            "default": "urn:packman:problem:"
                        }
                    },
                    "additionalProperties": false
                },
                "unsafe": {
                    "type": "object",
                    "properties": {
                        "allow_in_production": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
