{
    "$schema": "./schemas/packman.schema.json",
    "schema_version": 1,
    "name": "axiomasoft/packman-monorepo",
    "profile": "modular-platform",
    "php": "^8.4",
    "phpstan_level": "max",
    "provider_max_lines": 80,
    "packages": [
        {
            "name": "axiomasoft/packman",
            "path": "packages/core",
            "namespace": "Packman\\",
            "profile": "php-library",
            "layer": "L1",
            "type": "kernel"
        },
        {
            "name": "axiomasoft/packman-schema",
            "path": "packages/schema",
            "namespace": "Packman\\Schema\\",
            "profile": "laravel-package",
            "layer": "L2",
            "type": "addon"
        },
        {
            "name": "axiomasoft/packman-plugins",
            "path": "packages/plugins",
            "namespace": "Packman\\Plugins\\",
            "profile": "laravel-package",
            "layer": "L2",
            "type": "addon"
        },
        {
            "name": "axiomasoft/packman-modules",
            "path": "packages/modules",
            "namespace": "Packman\\Modules\\",
            "profile": "modular-platform",
            "layer": "L2",
            "type": "addon"
        },
        {
            "name": "axiomasoft/packman-panels",
            "path": "packages/panels",
            "namespace": "Packman\\Panels\\",
            "profile": "laravel-package",
            "layer": "L2",
            "type": "addon"
        },
        {
            "name": "axiomasoft/packman-filament",
            "path": "packages/filament",
            "namespace": "Packman\\Filament\\",
            "profile": "laravel-package",
            "layer": "L3",
            "type": "integration"
        },
        {
            "name": "axiomasoft/packman-testkit",
            "path": "packages/testkit",
            "namespace": "Packman\\Testkit\\",
            "profile": "laravel-package",
            "layer": "L4",
            "type": "dev",
            "dev_only": true
        },
        {
            "name": "axiomasoft/packman-devtools",
            "path": "packages/devtools",
            "namespace": "Packman\\DevTools\\",
            "profile": "laravel-package",
            "layer": "L4",
            "type": "dev",
            "dev_only": true
        }
    ],
    "gates": {
        "strict_ownership": true,
        "provider_size_limit": 80,
        "disallow_internal_cross_imports": true,
        "require_api_manifest": true,
        "error_urn_prefix": "urn:packman:problem:"
    }
}
