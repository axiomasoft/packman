{
    "name": "axiomasoft/packman-plugins",
    "description": "Universal Packman intra-package plugin graph compiler, capabilities, typed slots, and immutable contribution registry.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^1.0@dev",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "suggest": {
        "axiomasoft/packman-schema": "Optional schema ownership integration for plugins declaring owned schema nouns."
    },
    "autoload": {
        "psr-4": {
            "Packman\\Plugins\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packman\\Plugins\\Tests\\": "tests/"
        }
    },
    "extra": {
        "packman": {
            "error-prefix": "plugins"
        },
        "laravel": {
            "providers": [
                "Packman\\Plugins\\Laravel\\PluginsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
