#!/usr/bin/env php
<?php

declare(strict_types=1);

use Packman\DevTools\Console\ApplicationFactory;

$composerAutoload = $GLOBALS['_composer_autoload_path'] ?? ($_composer_autoload_path ?? null);

$candidates = array_values(array_filter([
    is_string($composerAutoload) && $composerAutoload !== '' ? $composerAutoload : null,
    dirname(__DIR__, 3).'/autoload.php',
    dirname(__DIR__).'/vendor/autoload.php',
    dirname(__DIR__, 3).'/vendor/autoload.php',
], is_string(...)));

$autoload = null;
foreach ($candidates as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Unable to locate Composer autoload.php for Packman DevTools CLI.\n");
    exit(1);
}

require_once $autoload;

$cwd = getcwd();
$root = is_string($cwd) && (is_file($cwd.'/packman.json') || is_file($cwd.'/composer.json'))
    ? $cwd
    : dirname(realpath($autoload) ?: $autoload, 2);

exit(ApplicationFactory::create($root)->run());
