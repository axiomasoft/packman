{
    "name": "fixture/standalone-laravel-consumer",
    "description": "Standalone Laravel consumer verifying stateless ExtensionPlugin, WithConfiguration, Configurable, WithSchema, PluginCatalog, Contributions, and SchemaMigrator without packman-modules.",
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/plugins",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman-plugins": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/schema",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman-schema": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/testkit",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman-testkit": "1.0.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^1.0@dev",
        "axiomasoft/packman-plugins": "^1.0@dev",
        "axiomasoft/packman-schema": "^1.0@dev"
    },
    "require-dev": {
        "axiomasoft/packman-testkit": "^1.0@dev",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Fixture\\StandaloneLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fixture\\StandaloneLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
