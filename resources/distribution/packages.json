{
    "packages": {
        "axiomasoft/packman": {
            "0.1.2": {
                "name": "axiomasoft/packman",
                "description": "Packman unified ecosystem kernel — attributes, foundation registrars, context contracts, JsonDocument, configuration options/compiler/cache, RFC 9457 error registry, doctor diagnostics, domain events, features, and settings contracts.",
                "type": "library",
                "license": "MIT",
                "keywords": [
                    "packman",
                    "php",
                    "kernel",
                    "attributes",
                    "config",
                    "errors",
                    "doctor",
                    "laravel"
                ],
                "authors": [
                    {
                        "name": "Dmitry Vostrikov",
                        "email": "dv.vostrikov@gmail.com"
                    }
                ],
                "homepage": "https://github.com/axiomasoft/packman",
                "support": {
                    "issues": "https://github.com/axiomasoft/packman/issues",
                    "source": "https://github.com/axiomasoft/packman",
                    "security": "https://github.com/axiomasoft/packman/blob/main/SECURITY.md"
                },
                "require": {
                    "php": "^8.4",
                    "psr/clock": "^1.0"
                },
                "suggest": {
                    "illuminate/console": "Optional Laravel Artisan console commands (`packman:doctor`, `packman:config:validate`).",
                    "illuminate/contracts": "Optional Laravel container, event dispatcher, config, and validation bindings.",
                    "illuminate/database": "Optional schema status checks in Laravel applications.",
                    "illuminate/support": "Optional PackmanServiceProvider auto-discovery and Laravel adapters."
                },
                "autoload": {
                    "psr-4": {
                        "Packman\\": "packages/core/src/"
                    }
                },
                "autoload-dev": {
                    "psr-4": {
                        "Packman\\Core\\Tests\\": "packages/core/tests/"
                    }
                },
                "extra": {
                    "packman": {
                        "schema-version": 1,
                        "package-type": "kernel",
                        "stability": "stable",
                        "error-prefix": "packman",
                        "owns": [
                            "Attributes",
                            "Config",
                            "Context",
                            "Data",
                            "Doctor",
                            "Errors",
                            "Events",
                            "Features",
                            "Foundation",
                            "Settings"
                        ]
                    },
                    "laravel": {
                        "providers": [
                            "Packman\\PackmanServiceProvider"
                        ]
                    },
                    "branch-alias": {
                        "dev-main": "0.1.x-dev"
                    }
                },
                "version": "0.1.2",
                "source": {
                    "type": "git",
                    "url": "https://github.com/axiomasoft/packman.git",
                    "reference": "v0.1.2"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/axiomasoft/packman/zipball/v0.1.2",
                    "reference": "v0.1.2"
                }
            }
        },
