{
    "name": "axiomasoft/packman-panels",
    "description": "Universal Packman headless panel descriptors, two-phase PanelRegistry/PanelRecipe builder, slot/form data projection, admission evaluation, and SQL saved views.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "homepage": "https://github.com/axiomasoft/packman",
    "support": {
        "issues": "https://github.com/axiomasoft/packman/issues",
        "source": "https://github.com/axiomasoft/packman",
        "security": "https://github.com/axiomasoft/packman/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/clock": "^1.0"
    },
    "suggest": {
        "axiomasoft/packman-modules": "Optional module and entity registry integration for ModulePanelCatalogue and EntityViewSchemaProvider.",
        "axiomasoft/packman-plugins": "Optional extension plugin integration for WithPanels providers."
    },
    "autoload": {
        "psr-4": {
            "Packman\\Panels\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packman\\Panels\\Tests\\": "tests/"
        }
    },
    "extra": {
        "packman": {
            "error-prefix": "panels"
        },
        "laravel": {
            "providers": [
                "Packman\\Panels\\Laravel\\PanelsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
