{
    "name": "axiomasoft/packman-filament",
    "description": "Universal Packman Filament 5 plugin wiring, Livewire/Filament security hooks, and stateless encrypted BindingEditor helpers.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^1.0@dev",
        "axiomasoft/packman-panels": "^1.0@dev",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Packman\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packman\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "packman": {
            "error-prefix": "filament"
        },
        "laravel": {
            "providers": [
                "Packman\\Filament\\PackmanFilamentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
