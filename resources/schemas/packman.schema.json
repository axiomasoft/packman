{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://axiomasoft.dev/schemas/packman/packman.schema.json",
    "title": "Packman Monorepo Configuration",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "name", "profile", "packages"],
    "properties": {
        "$schema": { "type": "string" },
        "schema_version": { "type": "integer", "const": 1 },
        "name": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
        "profile": { "enum": ["php-library", "laravel-package", "modular-platform", "product"] },
        "php": { "type": "string", "minLength": 1 },
        "phpstan_level": { "type": ["string", "integer"] },
        "provider_max_lines": { "type": "integer", "minimum": 1, "maximum": 500 },
        "packages": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "path", "namespace", "profile", "layer", "type"],
                "properties": {
                    "name": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
                    "path": { "type": "string", "minLength": 1 },
                    "namespace": { "type": "string", "pattern": "^(|.*\\\\)$" },
                    "profile": { "enum": ["php-library", "laravel-package", "modular-platform", "product", "metapackage"] },
                    "layer": { "enum": ["L1", "L2", "L3", "L4"] },
                    "type": { "enum": ["kernel", "foundation", "addon", "domain", "capability", "integration", "dev", "tooling", "product", "metapackage"] },
                    "dev_only": { "type": "boolean" },
                    "owns": {
                        "type": "array",
                        "items": { "type": "string" }
                    }
                }
            }
        },
        "gates": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "strict_ownership": { "type": "boolean" },
                "provider_size_limit": { "type": "integer", "minimum": 1 },
                "disallow_internal_cross_imports": { "type": "boolean" },
                "require_api_manifest": { "type": "boolean" },
                "error_urn_prefix": { "type": "string" }
            }
        }
    }
}
