{
    "name": "fixture/modular-platform-consumer",
    "description": "Modular platform consumer verifying Composer-discovered ModuleDefinition, With* traits via ExtensionInspector, RegistryCompiler, Schema, Panels, and PackmanFilamentPlugin.",
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/schema",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman-schema": "0.1.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/modules",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman-modules": "0.1.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/panels",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman-panels": "0.1.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/filament",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman-filament": "0.1.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/testkit",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman-testkit": "0.1.1"
                }
            }
        },
        {
            "type": "path",
            "url": "modules/crm",
            "options": {
                "symlink": true,
                "versions": {
                    "fixture/crm-module": "0.1.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-filament": "^0.1",
        "axiomasoft/packman-modules": "^0.1",
        "axiomasoft/packman-panels": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "fixture/crm-module": "^0.1"
    },
    "require-dev": {
        "axiomasoft/packman-testkit": "^0.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Fixture\\ModularPlatform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fixture\\ModularPlatform\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
