#!/usr/bin/env php
<?php

declare(strict_types=1);

use Packman\DevTools\Console\ApplicationFactory;

$candidates = [
    dirname(__DIR__, 3).'/vendor/autoload.php',
    dirname(__DIR__).'/vendor/autoload.php',
];

$autoload = null;
foreach ($candidates as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Unable to locate Composer autoload.php for Packman DevTools CLI.\n");
    exit(1);
}

require_once $autoload;

$cwd = getcwd();
$root = is_string($cwd) && is_file($cwd.'/packman.json') ? $cwd : dirname($autoload, 2);

exit(ApplicationFactory::create($root)->run());
