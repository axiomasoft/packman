{
    "name": "axiomasoft/packman-testkit",
    "description": "Shared testing harnesses, PostgreSQL database isolation, concurrency barriers, contract assertions, and fake recorders for Packman packages.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "homepage": "https://github.com/axiomasoft/packman",
    "support": {
        "issues": "https://github.com/axiomasoft/packman/issues",
        "source": "https://github.com/axiomasoft/packman",
        "security": "https://github.com/axiomasoft/packman/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/testing": "^12.0|^13.0",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "suggest": {
        "axiomasoft/packman-modules": "Enables ModuleContractTests and module discovery harness assertions.",
        "axiomasoft/packman-plugins": "Enables PluginContractTests and PluginGraph deterministic compilation checks.",
        "pestphp/pest": "First-class Pest integration helpers.",
        "symfony/yaml": "Enables YAML OpenAPI specification loading in OpenApiResponse."
    },
    "autoload": {
        "psr-4": {
            "Packman\\Testkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packman\\Testkit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "packman": {
            "profile": "laravel-package",
            "dev_only": true
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
