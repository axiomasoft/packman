{
    "name": "axiomasoft/packman-devtools",
    "description": "Shared monorepo quality gates, API/error/config scanners, scaffolding stubs, Rector rules, AI pack sync, and subtree split tools for Packman.",
    "type": "library",
    "license": "MIT",
    "bin": [
        "bin/packman"
    ],
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^0.1|^1.0@dev",
        "driftingly/rector-laravel": "^2.0",
        "illuminate/support": "^12.0|^13.0",
        "nette/neon": "^3.4",
        "nikic/php-parser": "^5.4",
        "opis/json-schema": "^2.4",
        "phpstan/phpdoc-parser": "^2.1",
        "rector/rector": "^2.0",
        "symfony/console": "^7.2|^8.0",
        "symfony/finder": "^7.2|^8.0",
        "symfony/process": "^7.2|^8.0",
        "symfony/yaml": "^7.2|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Packman\\DevTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packman\\DevTools\\Tests\\": "tests/"
        }
    },
    "extra": {
        "packman": {
            "profile": "laravel-package",
            "dev_only": true
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
